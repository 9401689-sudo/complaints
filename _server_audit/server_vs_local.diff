+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
+APP_FILE="$ROOT_DIR/app.js"
+UTILS_FILE="$ROOT_DIR/list-filter-query-utils.js"
+
+require_file() {
+  local file="$1"
+  if [[ ! -f "$file" ]]; then
+    echo "[FAIL] file not found: $file" >&2
+    exit 1
+  fi
+}
+
+require_pattern() {
+  local pattern="$1"
+  local file="$2"
+  local title="$3"
+  if grep -Eq "$pattern" "$file"; then
+    echo "[OK] $title"
+  else
+    echo "[FAIL] $title" >&2
